  "x-gframework-config-path": "config/gameplay",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "speed"],
  "properties": {
    "id": { "type": "integer" },
    "speed": { "type": "number", "minimum": 20, "maximum": 600 }
  }
}
