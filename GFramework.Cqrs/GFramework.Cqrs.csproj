<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>GeWuYou.$(AssemblyName)</PackageId>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EnableGFrameworkPackageTransitiveGlobalUsings>true</EnableGFrameworkPackageTransitiveGlobalUsings>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\GFramework.Cqrs.Abstractions\GFramework.Cqrs.Abstractions.csproj"/>
        <ProjectReference Include="..\GFramework.Core.Abstractions\GFramework.Core.Abstractions.csproj"/>
    </ItemGroup>

    <!-- runtime 直接基于标准 DI 与 Microsoft.Extensions.Logging 工作，显式声明这些依赖而不是依赖 Core.Abstractions 传递 -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15"/>
        <!-- Logger&lt;T&gt; 位于 Microsoft.Extensions.Logging 包；开放泛型 ILogger&lt;&gt; 注册需要该实现类型 -->
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14"/>
    </ItemGroup>

    <!-- Package the module guide named by PackageReadmeFile. -->
    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath=""/>
    </ItemGroup>
</Project>
